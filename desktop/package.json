{
  "name": "flok-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Flok messenger for Windows",
  "main": "main.js",
  "author": "Narezany",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.narezany.flok",
    "productName": "Flok",
    "copyright": "Flok",
    "directories": {
      "output": "../dist/windows"
    },
    "files": [
      "main.js",
      "icon.png",
      "web/**/*"
    ],
    "win": {
      "icon": "icon.ico",
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Flok-Setup-${version}.exe",
      "shortcutName": "Flok"
    },
    "portable": {
      "artifactName": "Flok-Portable-${version}.exe"
    }
  }
}
